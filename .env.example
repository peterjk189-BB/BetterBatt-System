# Copy this file to .env.local for local development.
# In production these are set in Vercel Project Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://oxkzmsvrckmgyfbgzkct.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. NEVER expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email (Resend). Set in Vercel only — never commit a real key.
RESEND_API_KEY=re_your-key-here
# Must be on a domain verified in Resend, e.g.:
RESEND_FROM=Better Batt Insulation <jobs@betterbattinsulation.com.au>
